    }
  ],
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": [
    "apple music",
    "music",
    "playlists",
    "airplay",
    "macos"
  ],
  "license": "MIT",
  "icon": "icon.png"
}
