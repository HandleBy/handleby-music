{
  "manifest_version": "0.2",
  "name": "handleby-music",
  "display_name": "HandleBy Music",
  "version": "1.2.0",
  "description": "Work with Apple Music from Claude on a Mac: playback, library, playlists, AirPlay, catalog search, listening history, recommendations and Replay.",
  "long_description": "HandleBy Music controls the Music app on your Mac through AppleScript and uses the Apple Music API after a one-time Apple ID sign-in. It plays and controls music, searches your library and the full Apple Music catalog, builds and edits playlists, picks AirPlay speakers, and reads your listening history, heavy rotation, recommendations and Replay. Not affiliated with Apple. See the README for exactly what it sends and where.",
  "author": {
    "name": "HandleBy LLC",
    "email": "jaden@kellans.com",
    "url": "https://handleby.ai"
  },
  "homepage": "https://handleby.ai/music",
  "repository": {
    "type": "git",
    "url": "https://github.com/HandleBy/handleby"
  },
  "support": "mailto:jaden@kellans.com",
  "privacy_policies": [
    "https://handleby.ai/music/privacy"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/server.js"
      ],
      "env": {}
    }
  },
  "tools": [
    {
      "name": "now_playing",
      "description": "Now playing"
    },
    {
      "name": "playback_control",
      "description": "Playback control"
    },
    {
      "name": "set_playback_options",
      "description": "Set volume, shuffle, repeat or position"
    },
    {
      "name": "search_library",
      "description": "Search my library"
    },
    {
      "name": "play_track",
      "description": "Play a library song"
    },
    {
      "name": "list_playlists",
      "description": "List my playlists"
    },
    {
      "name": "get_playlist",
      "description": "Get playlist tracks"
    },
    {
      "name": "play_playlist",
      "description": "Play a playlist"
    },
    {
      "name": "create_playlist",
      "description": "Create a playlist"
    },
    {
      "name": "add_to_playlist",
      "description": "Add songs to a playlist"
    },
    {
      "name": "remove_from_playlist",
      "description": "Remove songs from a playlist"
    },
    {
      "name": "rename_playlist",
      "description": "Rename a playlist"
    },
    {
      "name": "favorite_current_track",
      "description": "Favorite the current song"
    },
    {
      "name": "listening_stats",
      "description": "Listening stats"
    },
    {
      "name": "library_overview",
      "description": "Library overview"
    },
    {
      "name": "list_airplay_devices",
      "description": "List AirPlay speakers"
    },
    {
      "name": "set_airplay_devices",
      "description": "Choose AirPlay speakers"
    },
    {
      "name": "search_catalog",
      "description": "Search the Apple Music catalog"
    },
    {
      "name": "open_in_music",
      "description": "Open in the Music app"
    },
    {
      "name": "apple_music_account_status",
      "description": "Apple Music API status"
    },
    {
      "name": "configure_apple_music_api",
      "description": "Use my own MusicKit key (optional)"
    },
    {
      "name": "connect_apple_music_account",
      "description": "Connect my Apple Music account"
    },
    {
      "name": "recently_played",
      "description": "Recently played (account-wide)"
    },
    {
      "name": "heavy_rotation",
      "description": "Heavy rotation"
    },
    {
      "name": "recommendations",
      "description": "My recommendations"
    },
    {
      "name": "replay",
      "description": "Apple Music Replay"
    },
    {
      "name": "charts",
      "description": "Apple Music charts"
    },
    {
      "name": "add_to_library",
      "description": "Add to my library"
    },
    {
      "name": "favorite",
      "description": "Favorite songs, albums or playlists"
    },
    {
      "name": "rate",
      "description": "Love or dislike"
    },
    {
      "name": "library_playlists",
      "description": "My playlists (API)"
    },
    {
      "name": "create_catalog_playlist",
      "description": "Create a playlist from Apple Music songs"
    },
    {
      "name": "add_catalog_songs_to_playlist",
